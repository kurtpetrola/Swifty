<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light Mode). -->
    <style name="Theme.Swifty" parent="Theme.MaterialComponents.Light.DarkActionBar">

        <!-- Status bar color is set to the dark variant (@color/purple_700) -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Since the Status Bar color is DARK (colorPrimaryVariant), we ensure
              the icons (time, battery) are LIGHT (white/gray) for visibility.
              'false' is the default for dark status bars. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/lavender_primary</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/white</item>
        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/lexenddeca_bold</item>
        <item name="titleCentered">true</item>
    </style>

    <!-- Required style for InfosActivity, which uses a custom Toolbar -->
    <style name="Theme.Swifty.NoActionBar" parent="Theme.Swifty">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- For the large, expanded title (bottom of header) -->
    <style name="Theme.Swifty.CollapsingToolbar.Expanded" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/lexenddeca_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- For the small, collapsed title (top of header) -->
    <style name="Theme.Swifty.CollapsingToolbar.Collapsed" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/lexenddeca_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>